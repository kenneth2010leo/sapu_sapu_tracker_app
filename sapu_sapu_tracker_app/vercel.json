{
  "buildCommand": "git clone https://github.com/flutter/flutter.git -b stable && flutter/bin/flutter build web --release",
  "outputDirectory": "build/web",
  "installCommand": "echo \"SUPABASE_URL=$SUPABASE_URL\" > .env && echo \"SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY\" >> .env && echo \"MAPTILER_API_KEY=$MAPTILER_API_KEY\" >> .env",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
